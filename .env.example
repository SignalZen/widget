# Copy this file to .env.development and .env.production and fill in the values.
# VITE_* variables are inlined at build time — do not put secrets here.

# Rails API base URL
VITE_API_HOST=https://api.signalzen.com

# Node API base URL (leave empty to use VITE_API_HOST)
VITE_API_NODE_HOST=

# WebSocket cable URL
VITE_CABLE_URL=wss://api.signalzen.com/websockets/

# Google reCAPTCHA v2 site key (public — safe to commit per-env)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# URL at which the widget bundle is served (used for self-referencing)
VITE_CDN_WIDGET_V1_URL=https://cdn.signalzen.com/v1/signalzen.js
