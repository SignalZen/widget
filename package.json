{
  "name": "signalzen-widget",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "lint-staged": {
    "src/{widget,components/signalzen}/**/*.{ts,tsx}": "eslint --fix"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:widget": "vite build --config vite.widget.config.ts --mode production",
    "build:widget:dev": "vite build --config vite.widget.config.ts --mode development",
    "dev:widget": "concurrently -n build,serve -c cyan,magenta \"npm run build:widget:dev\" \"browser-sync start --server public --files 'public/signalzen.js' --port 8081 --no-notify --no-open\"",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:widget": "eslint \"src/widget/**/*.{ts,tsx}\" \"src/components/signalzen/**/*.{ts,tsx}\"",
    "lint:widget:fix": "eslint --fix \"src/widget/**/*.{ts,tsx}\" \"src/components/signalzen/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "prepare": "husky"
  },
